DATABASE_URL=
DIRECT_DATABASE_URL=
# Produção exige postgres. Local é apenas desenvolvimento/testes.
RATE_LIMIT_MODE=
RATE_LIMIT_KEY_SECRET=
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_KEY_NAME=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
APP_URL=

# Apenas bootstrap manual do administrador; não exigidos pelo runtime.
# Senha: 8 a 72 bytes, com maiúscula, número e caractere especial.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cron HTTP: secret server-only aleatório de 32 a 256 caracteres.
INTERNAL_JOBS_SECRET=
# Vercel Production: mesmo valor de INTERNAL_JOBS_SECRET; nunca NEXT_PUBLIC.
CRON_SECRET=
